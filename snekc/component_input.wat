;; A retained stdin resource with one sequential read request at a time.
;; stage: 0 idle, 1 requested, 2 ready, 3 stream pending, 4 stream closed,
;; 5 future pending, 6 request complete. Idle requests retain GC lookahead,
;; but never a borrowed linear-memory buffer.
(global $io.input-stage (mut i32) (i32.const 0))
(global $io.reader (mut i32) (i32.const 0))
(global $io.input-future (mut i32) (i32.const 0))
(global $io.input-error (mut i32) (i32.const 0))
(global $io.input-eof (mut i32) (i32.const 0))
(global $io.input-left (mut i32) (i32.const -1))
(global $io.input-line (mut i32) (i32.const 0))
(global $io.input-stop (mut i32) (i32.const 0))
(global $io.input-zero (mut i32) (i32.const 0))
(global $io.input-want (mut i32) (i32.const 0))
(global $io.input-buffer (mut (ref null $u8s)) (ref.null $u8s))
(global $io.input-pos (mut i32) (i32.const 0))
(global $io.input (mut (ref null $list.i32)) (ref.null $list.i32))

(func $io.read-start (param $size i32) (param $line i32)
  (if (global.get $io.input-stage) (then (unreachable)))
  (call $rt.flush)
  (global.set $io.input-left (local.get $size))
  (global.set $io.input-line (local.get $line))
  (global.set $io.input-stop (i32.eqz (local.get $size)))
  (global.set $io.input-zero (i32.eqz (local.get $size)))
  (global.set $io.input (struct.new $list.i32 (i32.const 0) (array.new_default $arr.i32 (i32.const 0))))
  (global.set $io.input-stage (i32.const 1)))

(func $io.read-result (result (ref $list.i32))
  (local $out (ref $list.i32)) (local $error i32)
  (if (i32.ne (global.get $io.input-stage) (i32.const 6)) (then (unreachable)))
  (local.set $out (ref.as_non_null (global.get $io.input)))
  ;; Zero-sized reads do not consult/acquire the underlying resource.
  (if (i32.eqz (global.get $io.input-zero)) (then (local.set $error (global.get $io.input-error))))
  (global.set $io.input (ref.null $list.i32))
  (global.set $io.input-stage (i32.const 0))
  (if (i32.eq (local.get $error) (i32.const 3))
    (then (throw $snek.exc (call $BrokenPipeError.__new__ (str.lit "stdin stream closed")))))
  (if (local.get $error)
    (then (throw $snek.exc (call $OSError.__new__ (str.lit "stdin read failed")))))
  (local.get $out))

(func $io.input-drop-reader
  (call $io.join (global.get $io.reader) (i32.const 0))
  (call $io.stream-drop-reader (global.get $io.reader))
  (global.set $io.reader (i32.const 0)))

(func $io.input-drop-future
  (call $io.join (global.get $io.input-future) (i32.const 0))
  (call $io.future-drop (global.get $io.input-future))
  (global.set $io.input-future (i32.const 0)))

(func $io.input-close
  ;; Only called after in-flight borrows have completed or been cancelled.
  (if (i32.or (i32.eq (global.get $io.input-stage) (i32.const 3))
              (i32.eq (global.get $io.input-stage) (i32.const 5))) (then (unreachable)))
  (if (global.get $io.reader) (then (call $io.input-drop-reader)))
  (if (global.get $io.input-future) (then (call $io.input-drop-future)))
  (global.set $io.input (ref.null $list.i32))
  (global.set $io.input-buffer (ref.null $u8s))
  (global.set $io.input-pos (i32.const 0))
  (global.set $io.input-eof (i32.const 0))
  (global.set $io.input-error (i32.const 0))
  (global.set $io.input-stage (i32.const 0)))

(func $io.input-consume
  (local $data (ref $u8s)) (local $pos i32) (local $byte i32)
  (if (ref.is_null (global.get $io.input-buffer)) (then (return)))
  (local.set $data (ref.as_non_null (global.get $io.input-buffer)))
  (local.set $pos (global.get $io.input-pos))
  (block $done (loop $copy
    (br_if $done (i32.or (global.get $io.input-stop) (i32.ge_u (local.get $pos) (array.len (local.get $data)))))
    (local.set $byte (array.get_u $u8s (local.get $data) (local.get $pos)))
    (call $list.i32.append (ref.as_non_null (global.get $io.input)) (local.get $byte))
    (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
    (if (i32.gt_s (global.get $io.input-left) (i32.const 0))
      (then
        (global.set $io.input-left (i32.sub (global.get $io.input-left) (i32.const 1)))
        (global.set $io.input-stop (i32.eqz (global.get $io.input-left)))))
    (if (i32.and (global.get $io.input-line) (i32.eq (local.get $byte) (i32.const 10)))
      (then (global.set $io.input-stop (i32.const 1))))
    (br $copy)))
  (global.set $io.input-pos (local.get $pos))
  (if (i32.eq (local.get $pos) (array.len (local.get $data)))
    (then (global.set $io.input-buffer (ref.null $u8s)) (global.set $io.input-pos (i32.const 0)))))

(func $io.input-copy (param $payload i32)
  (local $n i32) (local $i i32) (local $data (ref $u8s))
  (local.set $n (i32.shr_u (local.get $payload) (i32.const 4)))
  (if (i32.gt_u (local.get $n) (global.get $io.input-want)) (then (unreachable)))
  (local.set $data (array.new_default $u8s (local.get $n)))
  (block $done (loop $copy
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (array.set $u8s (local.get $data) (local.get $i) (i32.load8_u offset=1024 (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  (global.set $io.input-buffer (local.get $data))
  (global.set $io.input-pos (i32.const 0))
  (global.set $io.input-stage (i32.const 2))
  (if (i32.and (local.get $payload) (i32.const 15))
    (then (call $io.input-drop-reader) (global.set $io.input-eof (i32.const 1)))))

(func $io.input-finish (param $payload i32)
  ;; Futures return only CopyResult (unlike streams' count << 4 packing).
  (if (local.get $payload)
    (then (global.set $io.input-error (i32.const 1)))
    (else (if (i32.load8_u (i32.const 16))
      (then (global.set $io.input-error (i32.add (i32.load8_u (i32.const 17)) (i32.const 1)))))))
  (call $io.input-drop-future)
  (global.set $io.input-stage (i32.const 6)))

(func $io.input-pump (param $event i32) (param $handle i32) (param $payload i32) (result i32)
  (local $result i32)
  (if (i32.and (global.get $io.cancelled) (i32.eqz (global.get $io.injected)))
    (then
      ;; Detach before synchronous cancellation acknowledges the memory borrow.
      (if (i32.eq (global.get $io.input-stage) (i32.const 3))
        (then (call $io.join (global.get $io.reader) (i32.const 0))
          (drop (call $io.stream-cancel-read (global.get $io.reader)))))
      (if (i32.eq (global.get $io.input-stage) (i32.const 5))
        (then (call $io.join (global.get $io.input-future) (i32.const 0))
          (drop (call $io.future-cancel-read (global.get $io.input-future)))))
      (global.set $io.input-stage (i32.const 0))
      (call $io.input-close) (return (i32.const 0))))
  (if (i32.or (i32.eqz (global.get $io.input-stage)) (i32.eq (global.get $io.input-stage) (i32.const 6)))
    (then (return (i32.const 0))))
  (if (i32.eq (global.get $io.input-stage) (i32.const 1))
    (then
      (if (global.get $io.input-stop)
        (then (global.set $io.input-stage (i32.const 6)) (return (i32.const 0))))
      (if (i32.and (i32.eqz (global.get $io.reader)) (i32.eqz (global.get $io.input-eof)))
        (then
          (call $io.stdin (i32.const 24))
          (global.set $io.reader (i32.load (i32.const 24)))
          (global.set $io.input-future (i32.load (i32.const 28)))))
      (if (global.get $io.reader) (then (call $io.join (global.get $io.reader) (global.get $io.set))))
      (global.set $io.input-stage (i32.const 2))))
  (if (i32.eq (global.get $io.input-stage) (i32.const 3))
    (then
      (if (i32.or (i32.ne (local.get $event) (i32.const 2))
                  (i32.ne (local.get $handle) (global.get $io.reader))) (then (return (i32.const 1))))
      (call $io.input-copy (local.get $payload))))
  (if (i32.eq (global.get $io.input-stage) (i32.const 5))
    (then
      (if (i32.or (i32.ne (local.get $event) (i32.const 4))
                  (i32.ne (local.get $handle) (global.get $io.input-future))) (then (return (i32.const 1))))
      (call $io.input-finish (local.get $payload)) (return (i32.const 0))))
  (block $read-done (loop $read
    (call $io.input-consume)
    (if (global.get $io.input-eof)
      (then
        (if (i32.eqz (global.get $io.input-future))
          (then (global.set $io.input-stage (i32.const 6)) (return (i32.const 0))))
        (global.set $io.input-stage (i32.const 4)) (br $read-done)))
    (if (global.get $io.input-stop)
      (then
        (call $io.join (global.get $io.reader) (i32.const 0))
        (global.set $io.input-stage (i32.const 6)) (return (i32.const 0))))
    (global.set $io.input-want (i32.const 64512))
    (if (i32.and (i32.gt_s (global.get $io.input-left) (i32.const 0))
                 (i32.lt_u (global.get $io.input-left) (global.get $io.input-want)))
      (then (global.set $io.input-want (global.get $io.input-left))))
    (local.set $result (call $io.stream-read (global.get $io.reader) (i32.const 1024) (global.get $io.input-want)))
    (if (i32.eq (local.get $result) (i32.const -1))
      (then (global.set $io.input-stage (i32.const 3)) (return (i32.const 1))))
    (call $io.input-copy (local.get $result)) (br $read)))
  (call $io.join (global.get $io.input-future) (global.get $io.set))
  (local.set $result (call $io.future-read (global.get $io.input-future) (i32.const 16)))
  (if (i32.eq (local.get $result) (i32.const -1))
    (then (global.set $io.input-stage (i32.const 5)) (return (i32.const 1))))
  (call $io.input-finish (local.get $result)) (i32.const 0))
