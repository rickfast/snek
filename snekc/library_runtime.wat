;; Call-scoped bridge arena. Library targets disallow WASI arena users.
;; Strings are copied into the GC heap; private JS drivers retain opaque GC frames.
(global (export "__snek_abi") i32 (i32.const 5))
(export "__snek_yielded" (global $sm.yielded))
(global $__snek_bump (mut i32) (i32.const 65536))
(global $__snek_length (export "__snek_length") (mut i32) (i32.const 0))
;; Nested, non-user-code list operations borrow the current scratch frame.
(func (export "__snek_mark") (result i32) (global.get $__snek_bump))
(func (export "__snek_restore") (param $mark i32) (global.set $__snek_bump (local.get $mark)))
(func $__snek_reset (export "__snek_reset")
  (global.set $sm.yielded (i32.const 0))
  (global.set $rt.out_len (i32.const 0))
  (global.set $__snek_bump (i32.const 65536)))
(func $__snek_alloc (export "__snek_alloc") (param $n i32) (result i32)
  (local $ptr i32) (local $end i64) (local $pages i32)
  (local.set $ptr (global.get $__snek_bump))
  (local.set $end (i64.add (i64.extend_i32_u (local.get $ptr)) (i64.extend_i32_u (local.get $n))))
  (if (i64.gt_u (local.get $end) (i64.const 4294967295)) (then (unreachable)))
  (local.set $pages (i32.wrap_i64 (i64.shr_u (i64.add (local.get $end) (i64.const 65535)) (i64.const 16))))
  (if (i32.gt_u (local.get $pages) (memory.size))
    (then (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1)) (then (unreachable)))))
  (global.set $__snek_bump (i32.wrap_i64 (local.get $end)))
  (local.get $ptr))
(func $__snek_read (param $ptr i32) (param $n i32) (result (ref $str))
  (local $bytes (ref $u8s)) (local $i i32)
  (local.set $bytes (array.new_default $u8s (local.get $n)))
  (block $done (loop $copy
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (array.set $u8s (local.get $bytes) (local.get $i) (i32.load8_u (i32.add (local.get $ptr) (local.get $i))))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  (call $rt.mkstr (local.get $bytes) (i32.const -1)))
(func $__snek_write (param $s (ref $str)) (result i32)
  (local $bytes (ref $u8s)) (local $ptr i32) (local $i i32) (local $n i32)
  (local.set $bytes (struct.get $str $bytes (local.get $s)))
  (local.set $n (array.len (local.get $bytes)))
  (local.set $ptr (call $__snek_alloc (local.get $n)))
  (block $done (loop $copy
    (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
    (i32.store8 (i32.add (local.get $ptr) (local.get $i)) (array.get_u $u8s (local.get $bytes) (local.get $i)))
    (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $copy)))
  (global.set $__snek_length (local.get $n))
  (local.get $ptr))
