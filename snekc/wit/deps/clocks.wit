// Minimal subset of wasi:clocks@0.3.0. Apache-2.0 WITH LLVM-exception.
package wasi:clocks@0.3.0;

interface system-clock {
    record instant { seconds: s64, nanoseconds: u32 }
    now: func() -> instant;
}

interface monotonic-clock {
    now: func() -> u64;
    wait-for: async func(how-long: u64);
}
